library(Seurat)
library(tidyverse)
library(Seurat)

# create tiny synthetic dataset
mat <- matrix(rpois(200, lambda = 5), nrow = 20)
rownames(mat) <- paste0("gene", 1:20)
colnames(mat) <- paste0("cell", 1:10)

obj <- CreateSeuratObject(counts = mat)

obj <- NormalizeData(obj)
obj <- FindVariableFeatures(obj)
obj <- ScaleData(obj)
obj <- RunPCA(obj)

DimPlot(obj, reduction = "pca")
obj <- RunPCA(obj, npcs = 5)
DimPlot(obj, reduction = "pca")
obj <- RunPCA(obj, npcs = min(5, min(dim(obj))))
library(Seurat)

# create tiny synthetic dataset
mat <- matrix(rpois(200, lambda = 5), nrow = 20)
rownames(mat) <- paste0("gene", 1:20)
colnames(mat) <- paste0("cell", 1:10)

obj <- CreateSeuratObject(counts = mat)

obj <- NormalizeData(obj)
obj <- FindVariableFeatures(obj)
obj <- ScaleData(obj)
obj <- RunPCA(obj)

DimPlot(obj, reduction = "pca")
mat <- matrix(rpois(2000, lambda = 5), nrow = 200)
obj <- RunPCA(obj, npcs = 10)
quit()
